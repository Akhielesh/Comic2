{
  // DreamStream Studio Worker — owns the Sandbox Durable Object + Container.
  // See README.md before deploying. Replace the route domain with your real zone.
  "name": "dreamstream-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // The container image (Dockerfile in this dir). standard-3 = 2 vCPU / 8 GiB / 16 GB —
  // a good default for npm install + a Vite dev server (see CLOUDFLARE_STUDIO_PLAN §8).
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 50
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]

  // ⚠️ A CUSTOM DOMAIN IS REQUIRED for live preview URLs. Cloudflare's Sandbox SDK builds
  // subdomain preview URLs (<port>-<id>-<token>.<domain>) and its exposePort() THROWS
  // `CustomDomainRequiredError` on *.workers.dev (no wildcard sub-subdomains there).
  //
  // SETUP (after buying a cheap domain and adding it to Cloudflare as a zone):
  //   1. UNCOMMENT the "routes" block below and replace EXAMPLE.COM with your domain.
  //   2. Use the APEX domain (first-level wildcard `*.EXAMPLE.COM`) so free Universal SSL
  //      covers the preview hosts — a sub-subdomain like *.studio.EXAMPLE.COM would need a
  //      paid Advanced Certificate. A dedicated cheap domain just for the studio is ideal.
  //   3. `wrangler deploy`, then set Railway STUDIO_WORKER_URL = https://EXAMPLE.COM
  //      (the control endpoint shares the zone; proxyToSandbox routes only preview hosts).
  //
  // "routes": [
  //   { "pattern": "EXAMPLE.COM/*", "zone_name": "EXAMPLE.COM" },
  //   { "pattern": "*.EXAMPLE.COM/*", "zone_name": "EXAMPLE.COM" }
  // ]
}
