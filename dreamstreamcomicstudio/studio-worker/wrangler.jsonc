{
  // DreamStream Studio Worker — owns the Sandbox Durable Object + Container.
  // See README.md before deploying. Replace the route domain with your real zone.
  "name": "dreamstream-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // The container image (Dockerfile in this dir). standard-3 = 2 vCPU / 8 GiB / 16 GB —
  // a good default for npm install + a Vite dev server (see CLOUDFLARE_STUDIO_PLAN §8).
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 50
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }],

  // Preview domain (first-level wildcard → free Universal SSL covers the preview hosts).
  // The worker reads this to build `<port>-<id>-<token>.dreamstreamstudio.ai`.
  "vars": { "STUDIO_PREVIEW_DOMAIN": "dreamstreamstudio.ai" },

  // The worker only needs the WILDCARD route for previews. The bare apex (dreamstreamstudio.ai)
  // and www stay free for your real site/app. The CONTROL endpoint stays on the worker's
  // *.workers.dev URL — that's what Railway's STUDIO_WORKER_URL points at (control POSTs
  // don't need the domain; only exposePort does, and it uses STUDIO_PREVIEW_DOMAIN above).
  //
  // Requires: `dreamstreamstudio.ai` added to Cloudflare as a zone in THIS account.
  // (.com → .ai is a separate Redirect Rule in the dashboard — see README / OWNER-ACTIONS.)
  "routes": [
    { "pattern": "*.dreamstreamstudio.ai/*", "zone_name": "dreamstreamstudio.ai" }
  ]
}
