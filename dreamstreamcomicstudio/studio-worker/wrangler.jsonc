{
  // DreamStream Studio Worker — owns the Sandbox Durable Object + Container.
  // See README.md before deploying. Replace the route domain with your real zone.
  "name": "dreamstream-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // The container image (Dockerfile in this dir). standard-3 = 2 vCPU / 8 GiB / 16 GB —
  // a good default for npm install + a Vite dev server (see CLOUDFLARE_STUDIO_PLAN §8).
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 50
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]

  // NO custom domain needed: the Worker deploys to its free <name>.<account>.workers.dev
  // URL, and preview URLs come from zero-config Cloudflare quick tunnels
  // (sandbox.tunnels.get → *.trycloudflare.com). The control endpoint is the workers.dev URL.
  //
  // OPTIONAL (production, if you later buy a domain): add wildcard routes + switch the
  // Worker back to exposePort() for stable preview hostnames, e.g.:
  //   "routes": [
  //     { "pattern": "studio.<domain>/*", "zone_name": "<domain>" },
  //     { "pattern": "*.studio.<domain>/*", "zone_name": "<domain>" }
  //   ]
}
