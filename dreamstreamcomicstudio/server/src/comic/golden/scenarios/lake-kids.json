                  { "n": 2, "size": "medium", "shot": "medium", "angle": "", "action": "Frog hops onto a lily pad beside the Baby, who giggles.", "castIds": ["The Baby", "Frog"], "placeId": "", "mood": "", "lines": [{ "kind": "caption", "speakerId": "", "text": "Splish! Splash!" }] },
                  { "n": 3, "size": "medium", "shot": "medium", "angle": "", "action": "Bunny peeks from the reeds; everyone waves goodbye.", "castIds": ["The Baby", "Bunny", "Ducklings"], "placeId": "", "mood": "golden hour", "lines": [{ "kind": "speech", "speakerId": "The Baby", "text": "Bye-bye, friends!" }] }
                ]
              }
