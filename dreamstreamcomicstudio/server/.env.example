# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=http://localhost:5173

# Supabase
VITE_SUPABASE_URL=...
VITE_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# API server runtime
PORT=7071
CORS_ORIGIN=http://localhost:7000
MAX_BODY_SIZE=10mb
TRUST_PROXY=false
STRICT_ENV_VALIDATION=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_TEXT_MAX_REQUESTS=120
RATE_LIMIT_IMAGE_MAX_REQUESTS=40
RATE_LIMIT_VISION_MAX_REQUESTS=120
RATE_LIMIT_SYSTEM_MAX_REQUESTS=240
IDEMPOTENCY_TTL_MS=900000

# Storage
STORAGE_BUCKET=comic-assets

# Compatibility: set true only if legacy clients still require dataUrl in API responses.
IMAGE_INCLUDE_DATA_URL_LEGACY=false
