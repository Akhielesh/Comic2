# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_CREATOR=price_creator_...
STRIPE_PRICE_ID_PRO=price_pro_...
STRIPE_PRICE_ID_STUDIO=price_studio_...
STRIPE_PRICE_ID_CREDIT_PACK_10=price_credit_pack_10_...
STRIPE_PRICE_ID_CREDIT_PACK_25=price_credit_pack_25_...
STRIPE_PRICE_ID_CREDIT_PACK_100=price_credit_pack_100_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_MAX_AGE_SECONDS=86400
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings?tab=billing
CLIENT_URL=http://localhost:5173
BILLING_ENABLED=true

# Token Billing
BILLING_PLATFORM_MARKUP=1.30
GEMINI_PRICING_SOURCE_URL=https://ai.google.dev/gemini-api/docs/pricing
PIXAZO_PRICING_SOURCE_URL=https://www.pixazo.ai/
PRICING_MAJOR_DELTA_THRESHOLD=0.35

# Supabase
VITE_SUPABASE_URL=...
VITE_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# API server runtime
PORT=7071
CORS_ORIGIN=http://localhost:7000
MAX_BODY_SIZE=10mb
TRUST_PROXY=false
STRICT_ENV_VALIDATION=false
ASSISTANT_GEMINI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_TEXT_MAX_REQUESTS=120
RATE_LIMIT_IMAGE_MAX_REQUESTS=40
RATE_LIMIT_VISION_MAX_REQUESTS=120
RATE_LIMIT_SYSTEM_MAX_REQUESTS=240
IDEMPOTENCY_TTL_MS=900000

# Storage
STORAGE_BUCKET=comic-assets

# Compatibility: set true only if legacy clients still require dataUrl in API responses.
IMAGE_INCLUDE_DATA_URL_LEGACY=false
