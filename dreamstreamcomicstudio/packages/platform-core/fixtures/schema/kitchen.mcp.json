{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 10,
      "minLength": 1,
      "description": "A short title."
    },
    "code": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^[a-z]+$"
    },
    "line": {
      "type": "string",
      "maxLength": 50
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 5
      },
      "maxItems": 3,
      "minItems": 1
    },
    "level": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "compose",
        "reply"
      ]
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "flag": {
      "type": "boolean"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "link": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(https://|mailto:)",
      "description": "Where the button goes."
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "data"
            },
            "dataUri": {
              "type": "string",
              "maxLength": 159,
              "pattern": "^data:image/(png|jpeg|webp);base64,",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "kind",
            "dataUri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "asset"
            },
            "id": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]{0,199}$"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "p"
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "marks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "b",
                        "i"
                      ]
                    },
                    "maxItems": 2
                  },
                  "link": {
                    "type": "object",
                    "properties": {
                      "href": {
                        "type": "string",
                        "format": "uri",
                        "maxLength": 2048,
                        "pattern": "^(https://|mailto:)"
                      }
                    },
                    "required": [
                      "href"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "maxItems": 3
            }
          },
          "required": [
            "type",
            "runs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hr"
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 5
    }
  },
  "required": [
    "title",
    "code",
    "line",
    "tags",
    "level",
    "mode",
    "v",
    "count",
    "ratio",
    "flag",
    "email",
    "link",
    "asset",
    "rect",
    "block"
  ],
  "additionalProperties": false,
  "description": "Every kind the DSL has."
}
