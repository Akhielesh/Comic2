{
  "note": "Golden apply and undo cases: `before` and `ops` (inline or a {\"$ref\"} to another fixture) go through apply*Ops(before, ops, options); the call must give exactly `applied` (op ids, in order), `rejected` (index, opId, code; messages are for people and may change) and `after`. `undo` is invert*Ops(before, applied, {baseRev: after.rev, id: op => \"undo-\" + op.id}); applying it to `after` gives `before` back (apart from rev).",
  "cases": [
    {
      "name": "every contract op in one call (detaching the only attachment removes the field; set_recipients with cc [] keeps an empty cc)",
      "before": {
        "$ref": "contract/email/minimal.json"
      },
      "ops": {
        "$ref": "contract/email/ops.json"
      },
      "applied": [
        "op-1",
        "op-2",
        "op-3",
        "op-4",
        "op-5",
        "op-6",
        "op-7",
        "op-8"
      ],
      "rejected": [],
      "after": {
        "v": 1,
        "mode": "compose",
        "subject": "Hello again",
        "to": [
          {
            "address": "editor@example.com",
            "name": "Sam Editor"
          }
        ],
        "blocks": [
          {
            "type": "heading",
            "id": "h-new",
            "level": 2,
            "runs": [
              {
                "text": "News"
              }
            ]
          }
        ],
        "cc": [],
        "attachments": [
          {
            "id": "a2",
            "name": "Deck",
            "kind": "pptx",
            "spec": {
              "type": "deck",
              "deck": {
                "v": 1,
                "title": "Deck",
                "size": "16:9",
                "theme": {
                  "preset": "light"
                },
                "slides": []
              }
            }
          }
        ],
        "rev": 1
      },
      "undo": [
        {
          "op": "detach",
          "id": "undo-op-8",
          "baseRev": 1,
          "attachmentId": "a2"
        },
        {
          "op": "set_recipients",
          "id": "undo-op-7",
          "baseRev": 1,
          "actor": "user",
          "to": []
        },
        {
          "op": "attach",
          "id": "undo-op-6",
          "baseRev": 1,
          "index": 0,
          "attachment": {
            "id": "a1",
            "name": "Notes",
            "kind": "pdf",
            "spec": {
              "type": "doc",
              "doc": {
                "v": 1,
                "title": "Notes",
                "sections": []
              }
            }
          }
        },
        {
          "op": "detach",
          "id": "undo-op-5",
          "baseRev": 1,
          "attachmentId": "a1"
        },
        {
          "op": "insert_block",
          "id": "undo-op-4",
          "baseRev": 1,
          "index": 1,
          "block": {
            "type": "paragraph",
            "id": "p1",
            "runs": [
              {
                "text": "Hi again,"
              }
            ]
          }
        },
        {
          "op": "update_block",
          "id": "undo-op-3",
          "baseRev": 1,
          "actor": "agent",
          "blockId": "p1",
          "block": {
            "type": "paragraph",
            "id": "p1",
            "runs": [
              {
                "text": "Hi there,"
              }
            ]
          }
        },
        {
          "op": "remove_block",
          "id": "undo-op-2",
          "baseRev": 1,
          "blockId": "h-new"
        },
        {
          "op": "set_subject",
          "id": "undo-op-1",
          "baseRev": 1,
          "subject": "Hello"
