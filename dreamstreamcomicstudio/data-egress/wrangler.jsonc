{
  // DreamStream data-egress — allowlisted market-data fetch relay on the edge.
  // The backend's datacenter egress IPs are blocked by Yahoo/Stooq (every
  // stock/metals widget returned nothing in production); this worker fetches
  // those public endpoints from Cloudflare's IPs instead. Mounted on the zone
  // so the backend has a deterministic URL (no per-account workers.dev guess):
  //   https://dreamstreamstudio.ai/egress/fetch?url=…
  // REQUIRED secret (unset = 503 for every request): `wrangler secret put
  // EGRESS_SHARED_SECRET` here, the same value as DATA_EGRESS_SECRET on the
  // backend and as the EGRESS_SHARED_SECRET secret of the production-deploy
  // GitHub Environment (the deploy probe sends it).
  "name": "dreamstream-data-egress",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",

  "routes": [
    { "pattern": "dreamstreamstudio.ai/egress/*", "zone_name": "dreamstreamstudio.ai" }
  ]
}
