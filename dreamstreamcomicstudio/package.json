{
  "name": "dreamstream-comic-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node server/dist/server/src/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "openrouter:smoketest": "node scripts/openrouter-smoketest.mjs",
    "pricing:sync": "tsx server/src/jobs/dailyPricingSync.ts",
    "pricing:sync:check": "tsx server/src/jobs/dailyPricingSync.ts --check",
    "billing:reconcile": "tsx server/src/jobs/dailyBillingReconciliation.ts",
    "billing:reconcile:check": "tsx server/src/jobs/dailyBillingReconciliation.ts --check",
    "comicforge:worker": "tsx server/src/comicforge/worker.ts",
    "consistency:repair": "tsx scripts/repair_project_consistency.ts",
    "consistency:repair:apply": "tsx scripts/repair_project_consistency.ts --apply",
    "consistency:repair:clean-world": "tsx scripts/repair_project_consistency.ts --clean-world",
    "consistency:repair:clean-world:apply": "tsx scripts/repair_project_consistency.ts --apply --clean-world",
    "consistency:metrics": "tsx scripts/consistency_metrics.ts",
    "verify:world-contract": "tsx scripts/verify_world_contract_bundle.ts",
    "ops:verify:cors": "scripts/ops/verify-cors.sh",
    "ops:verify:rate-limit": "scripts/ops/verify-rate-limit.sh"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/dotenv": "^6.1.1",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.19.2",
    "ioredis": "^5.8.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.13.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.7.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
