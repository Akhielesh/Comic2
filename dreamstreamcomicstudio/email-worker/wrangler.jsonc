{
  // DreamStream Email Worker — branded transactional email via Cloudflare Email Sending.
  // Requires the Workers PAID plan ($5/mo) and a verified sending domain. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamstream-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",

  // Cloudflare Email Sending binding → available in the Worker as `env.EMAIL.send(...)`.
  "send_email": [{ "name": "EMAIL" }],

  // Public, non-secret config. Override per-environment in the dashboard or here.
  // Secrets (NOT here) are set with `wrangler secret put`:
  //   EMAIL_HMAC_SECRET          — shared with the Railway backend (signs /send calls)
  //   SUPABASE_AUTH_HOOK_SECRET  — Supabase "Send Email Hook" secret (v1,whsec_…); omit to disable /auth-hook
  "vars": {
    "EMAIL_FROM": "notifications@dreamstream.studio",
    "EMAIL_FROM_NAME": "DreamStream Studio",
    "EMAIL_REPLY_TO": "support@dreamstream.studio",
    "PRODUCT_NAME": "DreamStream Studio",
    "APP_URL": "https://dreamstream.studio",
    "SUPPORT_EMAIL": "support@dreamstream.studio",
    "COMPANY_NAME": "DreamStream Studio",
    "COMPANY_ADDRESS": "",
    "LOGO_URL": "",
    "SUPABASE_VERIFY_URL": "https://YOUR_PROJECT_REF.supabase.co"
  }

  // No public route needed — the backend reaches this Worker on its *.workers.dev URL,
  // and Supabase calls the /auth-hook path on that same URL. Add a "routes" entry only
  // if you want it on a custom domain.
}
