# Server-side keys (optional if using BYOK in the client)
GEMINI_API_KEY=
PIXAZO_API_KEY=
ASSISTANT_GEMINI_API_KEY=

# OpenRouter unified gateway (text + image, incl. Gemini-family models via OpenRouter).
# AI_PROVIDER: 'gemini' (legacy Google SDK + Pixazo) or 'openrouter' (unified gateway).
AI_PROVIDER=gemini
# Platform key funds paid-tier generation. Free-tier users send their own key via X-OpenRouter-Key (BYOK).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://dreamstream.studio
OPENROUTER_APP_TITLE=DreamStream Comic Studio
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_FREE_TEXT_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_REQUEST_TIMEOUT_MS=120000

# NVIDIA Build (NIM) — OpenAI-compatible TEXT/LLM source. BYOK: users add their own nvapi- key
# (free tier ~1,000 credits, 40 req/min). The platform key below is OPTIONAL and only used to
# populate the shared catalog when no user key is present.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_MS=60000

# Server config
PORT=7071
CORS_ORIGIN=http://localhost:7000
MAX_BODY_SIZE=10mb
TRUST_PROXY=false
STRICT_ENV_VALIDATION=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_TEXT_MAX_REQUESTS=120
RATE_LIMIT_IMAGE_MAX_REQUESTS=40
RATE_LIMIT_VISION_MAX_REQUESTS=120
RATE_LIMIT_SYSTEM_MAX_REQUESTS=240
IDEMPOTENCY_TTL_MS=900000

# Client config
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=

# Server-side storage persistence
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=comic-assets
IMAGE_INCLUDE_DATA_URL_LEGACY=false

# ComicForge queue/worker
REDIS_URL=
COMICFORGE_ENABLED=true
COMICFORGE_QUEUE_PREFIX=comicforge
COMICFORGE_WORKER_CONCURRENCY=4
COMICFORGE_JOB_RETENTION_DAYS=14
