# Server-side keys (optional if using BYOK in the client)
GEMINI_API_KEY=
PIXAZO_API_KEY=
ASSISTANT_GEMINI_API_KEY=

# OpenRouter unified gateway (text + image, incl. Gemini-family models via OpenRouter).
# AI_PROVIDER: 'gemini' (legacy Google SDK + Pixazo) or 'openrouter' (unified gateway).
AI_PROVIDER=gemini
# Named platform keys (preferred — set these in Railway):
#   DREAMSTREAMSTUDIO_ALL       serves ALL user traffic; per-user spend is hard-capped by the
#                               monthly platform allowance (PLATFORM_MONTHLY_ALLOWANCE_USD, default $5).
#   DREAMSTREAMSTUDIO_MODELTEST dedicated to model testing (bench:models, validate:sources,
#                               openrouter:smoketest, verify:run) — kept off the user-serving pool.
DREAMSTREAMSTUDIO_ALL=
DREAMSTREAMSTUDIO_MODELTEST=
# Legacy fallback platform key (used only when DREAMSTREAMSTUDIO_ALL is unset).
# Free-tier users send their own key via X-OpenRouter-Key (BYOK).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://dreamstreamstudio.ai
OPENROUTER_APP_TITLE=DreamStream Comic Studio
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_FREE_TEXT_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_REQUEST_TIMEOUT_MS=120000

# NVIDIA Build (NIM) — OpenAI-compatible TEXT/LLM source. BYOK: users add their own nvapi- key
# (free tier ~1,000 credits, 40 req/min). The platform key below is OPTIONAL and only used to
# populate the shared catalog when no user key is present.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_MS=60000

# --- Direct BYOK providers (OpenAI-compatible + Anthropic) ---
# Each is a "bring your own key" text source. A platform key is OPTIONAL and only used to
# populate the shared catalog / serve allowance traffic when no user key is present. Base
# URLs are overridable (slot in a proxy/Azure-style gateway). See shared/providers.ts.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Image model used by the chat generate_image tool when a user has an OpenAI key (BYOK).
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
# Google Gemini via its OpenAI-compatible endpoint (legacy native SDK path uses GEMINI_BASE_URL).
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
TENCENT_API_KEY=
TENCENT_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Image model used by the chat generate_image tool when a user has an xAI key (BYOK).
XAI_IMAGE_MODEL=grok-2-image

# Platform model-spend allowance — per-user monthly budget (USD) of PLATFORM-funded model
# usage (requests served on the server's OpenRouter/Gemini/NVIDIA keys; BYOK traffic never
# counts). 0 disables the feature entirely. Users only ever see PERCENT used — dollar
# amounts stay server-side (admins see USD via /api/admin/usage/users).
PLATFORM_MONTHLY_ALLOWANCE_USD=5

# Server config
PORT=7071
CORS_ORIGIN=http://localhost:7000
MAX_BODY_SIZE=10mb
TRUST_PROXY=false
STRICT_ENV_VALIDATION=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_TEXT_MAX_REQUESTS=120
RATE_LIMIT_IMAGE_MAX_REQUESTS=40
RATE_LIMIT_VISION_MAX_REQUESTS=120
RATE_LIMIT_SYSTEM_MAX_REQUESTS=240
IDEMPOTENCY_TTL_MS=900000

# Client config
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=
# Code Studio flags. Admins are never gated, so these only affect non-admins:
#   VITE_STUDIO_LIVE_ENABLED=true   → expose the live (cloud-container) Code Studio to everyone
#   VITE_LEGACY_STUDIO_ENABLED=true → revive the retired WebContainer page + Sandpack chat panel
VITE_STUDIO_LIVE_ENABLED=
VITE_LEGACY_STUDIO_ENABLED=
# DreamStream Live (video streaming) — base URL of the deployed live-worker.
# Defaults to http://127.0.0.1:8788 (local `wrangler dev`) when unset.
VITE_LIVE_WORKER_URL=

# Server-side storage persistence
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=comic-assets
IMAGE_INCLUDE_DATA_URL_LEGACY=false

# Queue/worker backend (BullMQ) — used by the ventures worker (npm run ventures:worker)
REDIS_URL=

# --- Transactional email (Cloudflare Email Sending via email-worker) ---
# Dormant until BOTH EMAIL_WORKER_URL and EMAIL_HMAC_SECRET are set (sends are skipped, nothing
# breaks). Full setup: docs/email/SETUP.md. The SAME EMAIL_HMAC_SECRET must be set as a secret
# on the email-worker (`wrangler secret put EMAIL_HMAC_SECRET`).
EMAIL_WORKER_URL=
EMAIL_HMAC_SECRET=
# Public origin of THIS backend — used to build absolute unsubscribe + read-receipt links in
# mail (e.g. https://api.dreamstreamstudio.ai). REQUIRED for marketing mail (working unsubscribe).
EMAIL_PUBLIC_BASE_URL=
# Public app origin for post-confirm redirects + in-email app links.
APP_PUBLIC_URL=https://dreamstreamstudio.ai
EMAIL_REQUEST_TIMEOUT_MS=15000
# HARD cost guardrails. Defaults are UNDER Cloudflare's free 3,000/month tier, so you cannot be
# billed for overage unless you deliberately raise EMAIL_MAX_PER_MONTH above 3000. A hit cap
# skips the send (logged status='rate_limited') and emits a cost alert to the server logs.
EMAIL_MAX_PER_DAY=200
EMAIL_MAX_PER_MONTH=2500
# Newsletter double opt-in confirm links expire after this many hours (0 = never).
NEWSLETTER_CONFIRM_TTL_HOURS=168

# --- Cloudflare Turnstile (bot protection) ---
# Fully dormant until BOTH keys are set: no widget renders and no endpoint is gated.
# Get keys at Cloudflare dashboard → Turnstile. Also enable Turnstile in Supabase
# (Authentication → Settings → Bot/Abuse protection) so captcha tokens are validated on
# signup/sign-in/magic-link/reset. See docs/email/SECURITY.md.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Data connectors (June 2026 audit — all optional; tools degrade honestly without them) ---
# Every key below has a genuinely FREE tier. They raise reliability and, where noted,
# unlock commercial-use rights ("free tier" and "free for commercial use" differ!).
# Full list + costs surfaced in-app: Settings → Tools → Connector upgrades.

# Web search (production should set at least one non-scraping provider):
# SearXNG self-host (free, unlimited — deploy the Railway template; ~$5/mo of resources)
SEARXNG_URL=
# Tavily: 1,000 free credits/mo, then ~$8/1k (best recurring free tier)
TAVILY_API_KEY=
# Brave: $5 free credit/mo ≈ 1k searches (attribution required), then $5/1k
BRAVE_API_KEY=
# Serper: 2,500 free one-time credits, then ~$0.30–1.00/1k (cheapest paid)
SERPER_API_KEY=
# Google Programmable Search (optional): 100/day free
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# US equities — Alpaca Market Data free Basic plan (IEX feed, ~200 req/min). With both
# keys set, get_stock serves US stock prices from the licensed feed instead of
# unofficial Yahoo endpoints (indices/commodities/FX stay on Yahoo/Stooq).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Crypto — CoinGecko. Demo key is free (10k calls/mo, NON-commercial); commercial
# display rights start at Basic ($35/mo). Set COINGECKO_API_PLAN=pro for paid plans.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=

# Weather. Default chain is MET Norway (free, commercial OK, CC BY) → Open-Meteo
# fallback. Open-Meteo's FREE API is non-commercial-only: set a paid key OR a
# self-hosted instance URL to make it primary again (richer card: AQI, pollen).
# Identify yourself to MET per their TOS (override the default contact UA):
MET_USER_AGENT=
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=

# IP geolocation — IPinfo Lite: free token, unlimited, commercial OK w/ attribution
# (country/ASN level). Without it, falls back to ip-api.com (non-commercial license).
IPINFO_TOKEN=

# Local places — Foursquare (ratings/photos/price); OpenStreetMap is the keyless fallback.
FOURSQUARE_API_KEY=

# Flight fare search — Amadeus Self-Service (search_flights tool → real airline fares).
# Free: create an app at developers.amadeus.com, paste the API Key + Secret here.
# Defaults to the TEST host (works with free self-service keys); set AMADEUS_PRODUCTION=true
# once you have production access. Without these, search_flights falls back to web search.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# AMADEUS_PRODUCTION=true

# In-app article reader fallback — Jina Reader (r.jina.ai) extracts articles from
# publishers that block datacenter IPs. Works keyless (low anonymous rate limit,
# best-effort); a free key raises limits a lot and makes "read in app" reliable.
JINA_API_KEY=

# Directions routing — defaults to the FOSSGIS public OSRM (fair use). Point at a
# self-hosted OSRM (or proxy) to lift limits: e.g. OSRM_BASE_URL=https://osrm.example.com
OSRM_BASE_URL=

# Edge egress relay for market data — Yahoo/Stooq/FiscalData block this backend's
# datacenter IPs; failed calls retry through the data-egress Cloudflare worker
# (auto-deployed; allowlisted hosts only). Default: https://dreamstreamstudio.ai/egress
# Set to '' to disable. DATA_EGRESS_SECRET must match the worker's
# EGRESS_SHARED_SECRET if you harden the relay with `wrangler secret put`.
DATA_EGRESS_URL=
DATA_EGRESS_SECRET=

# Per-provider call budgets (guardrails). Defaults sit under each provider's
# free-tier limits; override any without a deploy, e.g.:
#   PROVIDER_BUDGETS={"tavily":{"perMin":5,"perDay":20},"coingecko":{"perDay":200}}
# Live usage + health: GET /api/usage/providers (also shown in Settings → Tools).
PROVIDER_BUDGETS=

# === Account Connectors framework (user OAuth + API-key services) ====================
# Per-user account connectors (Gmail/Drive/Calendar/Sheets/YouTube via OAuth; Google
# Maps via API key). DISTINCT from the data connectors above — see
# docs/CONNECTORS_FRAMEWORK.md. The whole layer is INERT until configured: the catalog
# still renders and reports each connector "unavailable" rather than crashing.
#
# Master toggle (default on). Set false to hide the API + nav entirely.
CONNECTORS_ENABLED=true
# ONE Google OAuth client (Web application) shared by all Google OAuth connectors.
# Create at https://console.cloud.google.com/apis/credentials and enable the Gmail API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The callback registered with Google — MUST match exactly. Defaults to
# <EMAIL_PUBLIC_BASE_URL or http://localhost:PORT>/api/connectors/oauth/callback
GOOGLE_OAUTH_REDIRECT_URL=
# Where the browser lands after the callback (the SPA Connectors page). Defaults to
# <APP_PUBLIC_URL>/?view=connectors
CONNECTORS_APP_RETURN_URL=
# Shared platform API keys for the api_key connectors (users may also supply their own).
GOOGLE_MAPS_API_KEY=
YOUTUBE_API_KEY=
# Background sync worker (npm run connectors:worker) — reuses REDIS_URL above. Without
# Redis, syncs run inline in the API process instead.
CONNECTORS_QUEUE_PREFIX=connectors
CONNECTORS_WORKER_CONCURRENCY=3
CONNECTORS_SYNC_PAGE_SIZE=50
# Sync diagnostics — SEE exactly what each connector sync captures. Page-level START/DONE
# lines always print (connector, items captured + kind breakdown, running total, hasMore +
# next cursor). 'verbose' ALSO lists every captured item (kind + title). off|on|verbose.
CONNECTORS_SYNC_DEBUG=off
# Force ANSI color for the sync log on|off. Unset ⇒ auto (color on a TTY, plain JSON in prod).
CONNECTORS_SYNC_COLOR=
# In-flight OAuth handshake (PKCE state row) TTL, ms.
CONNECTORS_OAUTH_STATE_TTL_MS=600000
# Optional shared token to authenticate provider push webhooks (Gmail/Drive/Calendar
# watch). Empty ⇒ the webhook endpoint stays disabled (v1 polls).
CONNECTORS_WEBHOOK_TOKEN=
