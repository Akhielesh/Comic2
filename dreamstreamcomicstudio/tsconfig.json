{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "server",
    "live-worker",
    // Workers-runtime modules (DurableObject/Container base classes); typechecked by
    // api-proxy/tsconfig.json with @cloudflare/workers-types in deploy-api-proxy.yml.
    "api-proxy/src/index.ts",
    "api-proxy/src/backend.ts",
    "node_modules",
    "dist"
  ]
}
