-3.5" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span aria-hidden="true" class="hidden sm:inline">+ Sound effect</span></button></div><button type="button" class="inline-flex h-7 items-center justify-center gap-1 rounded-lg px-2 text-[11.5px] font-medium transition-colors duration-150 hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ds-ring)] disabled:cursor-not-allowed disabled:opacity-40 motion-reduce:transition-none coarse:h-11 coarse:min-w-11 coarse:px-2.5 coarse:text-[12.5px] text-[var(--ds-muted)]" title="Undo: move balloon (⌘Z)" aria-label="Undo move balloon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-undo2 lucide-undo-2 h-3.5 w-3.5" aria-hidden="true"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg></button><button type="button" class="inline-flex h-7 items-center justify-center gap-1 rounded-lg px-2 text-[11.5px] font-medium transition-colors duration-150 hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ds-ring)] disabled:cursor-not-allowed disabled:opacity-40 motion-reduce:transition-none coarse:h-11 coarse:min-w-11 coarse:px-2.5 coarse:text-[12.5px] text-[var(--ds-muted)]" disabled="" title="Redo (⇧⌘Z)" aria-label="Redo"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-redo2 lucide-redo-2 h-3.5 w-3.5" aria-hidden="true"><path d="m15 14 5-5-5-5"></path><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"></path></svg></button><button type="button" class="inline-flex h-7 items-center justify-center gap-1 rounded-lg px-2 text-[11.5px] font-medium transition-colors duration-150 hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ds-ring)] disabled:cursor-not-allowed disabled:opacity-40 motion-reduce:transition-none coarse:h-11 coarse:min-w-11 coarse:px-2.5 coarse:text-[12.5px] text-[var(--ds-muted)]" title="Re-place the balloons you haven’t moved by hand (free)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wand-sparkles h-3.5 w-3.5" aria-hidden="true"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"></path><path d="m14 7 3 3"></path><path d="M5 6v4"></path><path d="M19 14v4"></path><path d="M10 2v2"></path><path d="M7 8H3"></path><path d="M21 16h-4"></path><path d="M11 3H9"></path></svg> Tidy</button><button type="button" class="inline-flex h-7 items-center justify-center gap-1 rounded-lg px-2 text-[11.5px] font-medium transition-colors duration-150 hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ds-ring)] disabled:cursor-not-allowed disabled:opacity-40 motion-reduce:transition-none coarse:h-11 coarse:min-w-11 coarse:px-2.5 coarse:text-[12.5px] text-[var(--ds-warning-text)]" title="Move balloons that hug the page edge back inside the safe area (free)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles h-3.5 w-3.5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> Fix edges (2)</button><div role="radiogroup" aria-label="Editor view" class="inline-flex min-w-0 max-w-full rounded-xl bg-[var(--ds-segment-track)] p-0.5"><button type="button" role="radio" aria-checked="true" tabindex="0" title="Easy" class="flex min-w-0 flex-1 items-center justify-center gap-1 whitespace-nowrap rounded-[10px] font-medium transition-all duration-[var(--ds-motion-medium)] ease-[var(--ds-ease)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45 disabled:opacity-40 px-2 py-1 text-[11px] coarse:min-h-[44px] coarse:min-w-[44px] bg-[var(--ds-segment-pill)] text-[var(--ds-ink)] shadow-[shadow:var(--ds-shadow-segment)]"><span class="min-w-0 truncate">Easy</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" title="Pro" class="flex min-w-0 flex-1 items-center justify-center gap-1 whitespace-nowrap rounded-[10px] font-medium transition-all duration-[var(--ds-motion-medium)] ease-[var(--ds-ease)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45 disabled:opacity-40 px-2 py-1 text-[11px] coarse:min-h-[44px] coarse:min-w-[44px] text-[var(--ds-ink)] opacity-80 hover:opacity-100"><span class="min-w-0 truncate">Pro</span></button></div></div>"`;

exports[`flag off: the Pages tab and the toolbars are exactly today > the phone toolbar 1`] = `"<div class="flex min-h-0 min-w-0 shrink-0 w-full flex-col" data-testid="editor-toolbar-host"><div role="toolbar" aria-label="Page editor" aria-orientation="horizontal" data-testid="editor-toolbar" data-orientation="horizontal" class="flex shrink-0 bg-[var(--ds-surface-strong)] w-full items-stretch gap-0.5 border-t border-[var(--ds-hairline)] px-1.5 pt-1" style="padding-bottom: calc(var(--sa-bottom-eff, 0px) + 4px);"><div role="radiogroup" aria-label="Editing mode" class="flex min-w-0 flex-[2] gap-0.5"><button type="button" role="radio" aria-checked="true" aria-label="Move" title="Move" class="press relative flex shrink-0 select-none flex-col items-center justify-center gap-0.5 rounded-xl transition-colors duration-150 motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-40 h-12 min-w-[44px] flex-1 px-1 bg-[#D97757]/[0.12] text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mouse-pointer2 lucide-mouse-pointer-2 h-4 w-4" aria-hidden="true"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"></path></svg><span class="max-w-full truncate text-[10.5px] font-medium leading-none">Move</span></button><button type="button" role="radio" aria-checked="false" aria-label="Mark up" title="Mark up" class="press relative flex shrink-0 select-none flex-col items-center justify-center gap-0.5 rounded-xl transition-colors duration-150 motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-40 h-12 min-w-[44px] flex-1 px-1 text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed h-4 w-4" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="max-w-full truncate text-[10.5px] font-medium leading-none">Mark up</span></button></div><span aria-hidden="true" class="shrink-0 bg-[var(--ds-hairline)] mx-0.5 my-2 w-px"></span><button type="button" aria-label="Undo" title="Undo" class="press relative flex shrink-0 select-none flex-col items-center justify-center gap-0.5 rounded-xl transition-colors duration-150 motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-40 h-12 min-w-[44px] flex-1 px-1 text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-undo2 lucide-undo-2 h-4 w-4" aria-hidden="true"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg><span class="max-w-full truncate text-[10.5px] font-medium leading-none">Undo</span></button><button type="button" aria-label="Redo" title="Redo" class="press relative flex shrink-0 select-none flex-col items-center justify-center gap-0.5 rounded-xl transition-colors duration-150 motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-40 h-12 min-w-[44px] flex-1 px-1 text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-redo2 lucide-redo-2 h-4 w-4" aria-hidden="true"><path d="m15 14 5-5-5-5"></path><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"></path></svg><span class="max-w-full truncate text-[10.5px] font-medium leading-none">Redo</span></button><span aria-hidden="true" class="shrink-0 bg-[var(--ds-hairline)] mx-0.5 my-2 w-px"></span><button type="button" aria-expanded="false" aria-label="Lettering" title="Lettering" data-testid="toolbar-lettering" class="press relative flex shrink-0 select-none flex-col items-center justify-center gap-0.5 rounded-xl transition-colors duration-150 motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-40 h-12 min-w-[44px] flex-1 px-1 text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type h-4 w-4" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg><span class="max-w-full truncate text-[10.5px] font-medium leading-none">Lettering</span><span aria-hidden="true" class="absolute right-1 top-1 grid h-4 min-w-[16px] place-items-center rounded-full border px-1 text-[9.5px] font-semibold tabular-nums border-[color:color-mix(in_srgb,var(--ds-warning)_40%,transparent)] bg-[color:color-mix(in_srgb,var(--ds-warning)_10%,var(-