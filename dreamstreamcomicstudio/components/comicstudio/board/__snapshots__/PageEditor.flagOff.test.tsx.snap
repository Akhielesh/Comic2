exports[`flag off: the page editor is exactly today > desktop, Easy, nothing selected 1`] = `"<div></div><div class="fixed inset-x-0 top-0 z-[70] h-[var(--app-h,100dvh)] bg-black/45 p-4 backdrop-blur-sm" data-editor-layout="desktop"><div role="dialog" aria-modal="true" aria-label="Page 1 editor" tabindex="-1" class="flex h-full w-full flex-col overflow-hidden bg-[var(--ds-canvas)] shadow-2xl focus:outline-none rounded-2xl border border-[var(--ds-hairline)]"><header class="flex shrink-0 select-none items-center gap-2 border-b border-[var(--ds-hairline)] bg-[var(--ds-surface-strong)] px-2 py-1.5 sm:px-3 sm:py-2" data-testid="editor-header"><button type="button" aria-label="Previous page" title="Previous page" disabled="" class="inline-flex shrink-0 items-center justify-center rounded-xl text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] transition-all duration-[var(--ds-motion-medium)] ease-[var(--ds-ease)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45 disabled:cursor-not-allowed disabled:opacity-40 h-8 w-8 coarse:h-11 coarse:w-11"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-4 w-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><div class="min-w-0 flex-1"><div class="flex min-w-0 items-center gap-2 overflow-hidden"><h2 class="shrink-0 whitespace-nowrap text-[14px] font-semibold text-[var(--ds-ink)]">Page 1 <span class="font-normal text-[var(--ds-muted)]">of 6</span></h2><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10.5px] font-semibold border-[color:color-mix(in_srgb,var(--ds-success)_30%,transparent)] bg-[color:color-mix(in_srgb,var(--ds-success)_10%,transparent)] text-[var(--ds-success-text)] min-w-0">Drawn</span></div><p class="truncate text-[12px] text-[var(--ds-muted)]">Page 1 summary</p></div><button type="button" aria-label="Next page" title="Next page" class="inline-flex shrink-0 items-center justify-center rounded-xl text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] transition-all duration-[var(--ds-motion-medium)] ease-[var(--ds-ease)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45 disabled:cursor-not-allowed disabled:opacity-40 h-8 w-8 coarse:h-11 coarse:w-11"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-4 w-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button><button type="button" aria-label="Close editor" title="Close editor" class="inline-flex shrink-0 items-center justify-center rounded-xl text-[var(--ds-muted)] hover:bg-[var(--ds-hover)] hover:text-[var(--ds-ink)] transition-all duration-[var(--ds-motion-medium)] ease-[var(--ds-ease)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D97757]/45 disabled:cursor-not-allowed disabled:opacity-40 h-8 w-8 coarse:h-11 coarse:w-11"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-4 w-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><div class="flex min-h-0 min-w-0 flex-1 flex-row overflow-hidden" data-layout="desktop"><div class="flex min-h-0 min-w-0 flex-1 flex-col" data-testid="editor-stage"><div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-3 px-4 pt-3" data-testid="editor-mode-row"><div role="radiogroup" aria-label="Editing mode" class="inline-flex min-w-0 max-w-full rounded-xl bg-[var(--ds-segment-track)] p-0.5"><button type="button" role="radio" aria-checked="true" tabindex="0" class="flex min-w-0 flex-