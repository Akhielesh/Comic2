    },
    {
      "name": "New comic",
      "short_name": "New comic",
      "url": "/?view=dashboard&new=1&source=pwa",
      "icons": [{ "src": "/icons/comics-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Comic gallery",
