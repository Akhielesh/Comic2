# App-wide security headers (Comic Studio v5, contract §14.2).
# The CSP ships REPORT-ONLY first: the SPA still has an inline importmap and inline
# scripts, and third-party surfaces (maps, embeds, model CDNs) must be inventoried from
# real violation reports before anything is enforced. The share/reader route /c/* gets
# an ENFORCED CSP from its Pages Function (_headers never applies to Function responses).
# `report-uri /api/csp-report` is deliberately NOT set yet: until the edge handler for
# that path exists in the dreamstream-api Worker, reports would be forwarded to the
# backend container and wake it (CLAUDE.md "keep it sleepable"). The owner of the edge
# route appends "; report-uri /api/csp-report" to the policy below when it lands.
# Until then violations show in the browser console only.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://aistudiocdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Sign-in links land on these pages (the main app's /auth/callback, Stream Studio at /live).
# Another site must never frame them: a framed "Finish signing in?" step could hide a disguised
# Continue button (clickjacking). The pages refuse to sign in inside a frame too (services/authLink).
# /live* also covers the live app's files, where these headers are harmless.
/auth/callback*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

/live*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Installable-app manifest: revalidate so name/icon/shortcut changes reach installs.
/app.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# App icons: stable names (regenerated by scripts/gen-icons.mjs), so a day of cache
# then revalidate rather than immutable.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Baby-monitor alert service worker: always revalidate so fixes reach phones.
/live-sw.js
  Cache-Control: no-cache

# On-device AI models (baby-monitor sound model). Versioned file names → cache forever.
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
