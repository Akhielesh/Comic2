# Cross-origin isolation for the dedicated Code Studio page ONLY, so WebContainers
# can boot there. Scoped to /studio.html so the main app is NOT isolated (keeps OSM
# map tiles, image-search results and cross-origin embeds working everywhere else).
/studio.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Baby-monitor alert service worker: always revalidate so fixes reach phones.
/live-sw.js
  Cache-Control: no-cache

# On-device AI models (baby-monitor sound model). Versioned file names → cache forever.
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
