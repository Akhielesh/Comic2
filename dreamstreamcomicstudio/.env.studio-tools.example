# Code Studio agent-tool sidecars — env for deploy/studio-tools/docker-compose.yml AND the app.
# Copy the relevant lines into deploy/studio-tools/.env (for the compose) and into the app server's
# environment (for the running backend). Secrets are never printed by the app.

# --- Nango (self-hosted, Elastic License v2) ------------------------------------------------
# MANDATORY for the compose: generate ONCE and never change (no key rotation).
#   openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# Optional Nango DB/dashboard overrides (sensible defaults exist in the compose).
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_FLAG_AUTH_ENABLED=false
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=admin

# --- App server: enable the Nango connector tools (nango_search_integrations / _connect / _call_api)
# NANGO_HOST is the Nango base URL the app calls server-to-server; SECRET_KEY is copied from the
# Nango dashboard (Environment Settings) after first boot. DEFAULT_CONNECTION_ID is an optional
# test connection so agents can inspect real response shapes at build time.
NANGO_HOST=http://localhost:3003
NANGO_SECRET_KEY=
NANGO_DEFAULT_CONNECTION_ID=

# --- App server: self-hosted design / connector MCPs (HTTP allowed; treated as trusted) ------
# Point these at the supergateway endpoints from the compose (or any HTTPS-hosted MCP).
STUDIO_SHADCN_MCP_URL=http://localhost:8001/mcp
STUDIO_MAGICUI_MCP_URL=http://localhost:8002/mcp
# 21st.dev Magic — OPT-IN. Start the sidecar with `docker compose --profile magic up -d`, set
# MAGIC_API_KEY below to your 21st.dev key (free tier), then point the app here:
# STUDIO_MAGIC_MCP_URL=http://localhost:8003/mcp

# --- 21st.dev Magic API key (used ONLY by the magic-mcp sidecar; never sent to the repo/app) -----
# Get a free key at https://21st.dev (Magic → API keys). Set it in deploy/studio-tools/.env.
MAGIC_API_KEY=
# A self-hosted Nango MCP is connection-scoped; prefer the REST tools above unless you scope one.
# STUDIO_NANGO_MCP_URL=http://localhost:3003/mcp
# Optional per-server auth headers as JSON, e.g. for a scoped Nango MCP connection:
# STUDIO_NANGO_MCP_URL_HEADERS={"Authorization":"Bearer <secret>","connection-id":"<id>","provider-config-key":"<integration>"}

# --- Optional: raise shadcn MCP GitHub rate limit (60→5000 req/hr) ---------------------------
SHADCN_GITHUB_TOKEN=
